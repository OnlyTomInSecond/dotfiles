# =============================================================================
#  .zshenv — 始终加载（login + non-login），只放 PATH 等环境变量
# =============================================================================
typeset -U path PATH
path=(${HOME}/bin $path)
export PATH

# 跳过 /etc/zsh/* 全局配置，节省 ~5-10ms（如不需要系统级设置）
# setopt no_global_rcs

